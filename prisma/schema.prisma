// Esquema de control-gastos.
//
// Nota sobre montos: en Chile el peso no tiene decimales, asi que `monto` es Int
// (pesos enteros). Eso evita arrastrar Decimal, que ademas no serializa directo
// entre servidor y cliente en Next.js.
//
// Nota sobre fechas: `fecha` es @db.Date (solo dia, sin hora). Siempre se guarda
// y se lee como medianoche UTC. Ver src/lib/fecha.ts.
//
// Nota sobre hogares: los datos de la plata son de un HOGAR, no de una persona.
// Cada persona entra con su Google y es miembro de un hogar; un hogar puede
// tener uno o varios miembros.
//
// `hogarId` es obligatorio y no tiene valor por omision: cada fila dice de
// que hogar es. Lo que existia antes de los hogares quedo en el hogar de id
// "hogar-inicial" («Mi hogar»).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
  OTRO
}

enum RolMiembro {
  /// Creo el hogar: invita y saca miembros, cambia el nombre y el dia de inicio.
  DUENO
  /// Anota, paga y ve todo lo del hogar.
  MIEMBRO
}

/// Un hogar: el dueno de todos los datos de la plata.
model Hogar {
  id       String   @id @default(cuid())
  nombre   String   @db.VarChar(60)
  creadoEn DateTime @default(now()) @map("creado_en")

  miembros     Miembro[]
  categorias   Categoria[]
  gastos       Gasto[]
  sueldos      Sueldo[]
  deudas       Deuda[]
  cuentas      Cuenta[]
  presupuestos Presupuesto[]
  ahorros      Ahorro[]
  ajustes      Ajustes?
  /// El codigo pendiente para borrar el hogar, si el dueno pidio uno.
  codigoDeBorrado CodigoDeBorrado?

  @@map("hogares")
}

/// Una persona en un hogar, por su correo de Google.
///
/// El correo es unico: cada persona esta en un solo hogar. Mientras no entra
/// por primera vez (`entroEn` vacio) es una invitacion pendiente.
model Miembro {
  id         String     @id @default(cuid())
  hogarId    String     @map("hogar_id")
  /// En minusculas, como lo compara la entrada.
  correo     String     @unique @db.VarChar(254)
  /// El nombre que entrega Google. Vacio mientras es una invitacion.
  nombre     String?    @db.VarChar(120)
  rol        RolMiembro @default(MIEMBRO)
  invitadoEn DateTime   @default(now()) @map("invitado_en")
  /// La primera vez que entro. Vacio = invitacion pendiente.
  entroEn    DateTime?  @map("entro_en")

  /// Si el hogar se borra, sus miembros se van con el.
  hogar            Hogar             @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  gastosAnotados   Gasto[]
  codigosDeBorrado CodigoDeBorrado[]
  /// La app de autenticacion de su celular (verificacion en dos pasos).
  dosPasos          DosPasos?
  codigosDeRespaldo CodigoDeRespaldo[]
  sesionesVerificadas SesionVerificada[]

  @@index([hogarId])
  @@map("miembros")
}

/// El codigo que confirma que se borra un hogar. Llega al correo del dueno,
/// vale unos minutos y aguanta pocos intentos (src/dominio/hogar.ts). Se
/// guarda su huella, nunca el codigo. Uno por hogar: pedir otro reemplaza al
/// anterior.
model CodigoDeBorrado {
  hogarId   String   @id @map("hogar_id")
  /// Quien lo pidio: solo esa persona puede usarlo.
  miembroId String   @map("miembro_id")
  /// HMAC-SHA256 del codigo, en hexadecimal.
  huella    String   @db.Char(64)
  intentos  Int      @default(0)
  creadoEn  DateTime @default(now()) @map("creado_en")
  expiraEn  DateTime @map("expira_en")

  /// Se va con el hogar, y con quien lo pidio si deja de estar.
  hogar   Hogar   @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  miembro Miembro @relation(fields: [miembroId], references: [id], onDelete: Cascade)

  @@index([miembroId])
  @@map("codigos_de_borrado")
}

/// La verificacion en dos pasos de una persona: la app de autenticacion de
/// su celular (Google Authenticator u otra). Una por miembro. Mientras
/// `confirmadoEn` esta vacio, la esta configurando: escaneo el QR pero
/// todavia no escribio el primer codigo. Ver src/dominio/dos-pasos.ts.
model DosPasos {
  miembroId      String    @id @map("miembro_id")
  /// La clave de la app, cifrada con CLAVE_DOS_PASOS y atada al miembro
  /// (src/lib/dos-pasos.ts). Nunca se guarda a la vista.
  claveCifrada   String    @map("clave_cifrada") @db.VarChar(200)
  /// Desde cuando la app funciona. Vacio = configuracion a medias.
  confirmadoEn   DateTime? @map("confirmado_en")
  /// El ultimo paso de 30 segundos que se acepto: un codigo no sirve dos veces.
  ultimoPaso     Int?      @map("ultimo_paso")
  /// Codigos equivocados seguidos. Al llegar al limite se bloquea un rato.
  intentos       Int       @default(0)
  bloqueadoHasta DateTime? @map("bloqueado_hasta")
  creadoEn       DateTime  @default(now()) @map("creado_en")

  /// Se va con el miembro.
  miembro Miembro @relation(fields: [miembroId], references: [id], onDelete: Cascade)

  @@map("dos_pasos")
}

/// Un codigo de respaldo, por si se pierde el celular: sirve una vez en vez
/// del codigo de la app. Se guarda su huella (HMAC-SHA256), nunca el codigo.
model CodigoDeRespaldo {
  id        String    @id @default(cuid())
  miembroId String    @map("miembro_id")
  huella    String    @db.Char(64)
  /// Vacio = todavia sirve.
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")

  miembro Miembro @relation(fields: [miembroId], references: [id], onDelete: Cascade)

  @@unique([miembroId, huella])
  @@map("codigos_de_respaldo")
}

/// Una sesion que ya hizo el segundo paso. La sesion de Google trae un id al
/// azar (src/lib/ingreso.ts); al poner el codigo, ese id queda aqui. Cada
/// pagina revisa que su sesion este en esta tabla (src/lib/hogar-actual.ts).
model SesionVerificada {
  /// El id de la sesion: 32 caracteres hexadecimales.
  id           String   @id @db.Char(32)
  miembroId    String   @map("miembro_id")
  verificadaEn DateTime @default(now()) @map("verificada_en")
  /// Lo que dura una sesion como maximo: despues no vale aunque siga aqui.
  expiraEn     DateTime @map("expira_en")

  miembro Miembro @relation(fields: [miembroId], references: [id], onDelete: Cascade)

  @@index([miembroId])
  @@map("sesiones_verificadas")
}

model Categoria {
  id       String   @id @default(cuid())
  hogarId  String   @map("hogar_id")
  /// Unico dentro del hogar: dos hogares pueden tener cada uno su «Supermercado».
  nombre   String   @db.VarChar(60)
  /// Color hex para graficos y acentos, formato #RRGGBB.
  color    String   @db.VarChar(7)
  /// Nombre del icono de lucide-react.
  icono    String   @db.VarChar(40)
  /// true = gasto fijo o inevitable (arriendo, luz). false = discrecional.
  esencial Boolean  @default(false)
  orden    Int      @default(0)
  /// Las categorias no se borran si tienen gastos: se desactivan.
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  /// Un hogar con datos no se puede borrar de un tiron (Restrict): borrar un
  /// hogar sera una accion propia, que primero vacia lo suyo.
  hogar        Hogar         @relation(fields: [hogarId], references: [id], onDelete: Restrict)
  gastos       Gasto[]
  presupuestos Presupuesto[]
  cuentas      Cuenta[]

  @@unique([hogarId, nombre])
  /// Para que gastos, cuentas y presupuestos apunten a la categoria Y a su hogar.
  @@unique([id, hogarId])
  @@index([activa, orden])
  @@map("categorias")
}

model Gasto {
  id            String    @id @default(cuid())
  hogarId       String    @map("hogar_id")
  fecha         DateTime  @db.Date
  descripcion   String    @db.VarChar(120)
  /// Pesos chilenos enteros. Siempre mayor que cero (constraint en la migracion).
  monto         Int
  medioPago     MedioPago @default(DEBITO) @map("medio_pago")
  notas         String?   @db.VarChar(500)
  categoriaId   String    @map("categoria_id")
  /// Nombre del archivo de la boleta dentro de la carpeta de boletas.
  /// Solo el nombre, nunca una ruta: lo genera el servidor.
  boletaArchivo String?   @map("boleta_archivo") @db.VarChar(255)
  /// Quien lo anoto. Vacio en lo anotado antes de los hogares, o si esa
  /// persona ya no es miembro: el gasto es del hogar y se queda.
  anotadoPorId  String?   @map("anotado_por_id")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  hogar      Hogar        @relation(fields: [hogarId], references: [id], onDelete: Restrict)
  anotadoPor Miembro?     @relation(fields: [anotadoPorId], references: [id], onDelete: SetNull)
  /// La categoria tiene que ser del mismo hogar que el gasto: la llave va por
  /// los dos campos, asi la base rechaza un gasto con la categoria de otro.
  categoria  Categoria    @relation(fields: [categoriaId, hogarId], references: [id, hogarId], onDelete: Restrict)
  /// La cuenta que se pago y genero este gasto, si vino de ahi.
  cuenta     Cuenta?
  /// La cuota de deuda que se pago y genero este gasto, si vino de ahi.
  cuota      CuotaPagada?

  @@index([fecha])
  @@index([categoriaId, fecha])
  @@index([hogarId, fecha])
  @@map("gastos")
}

/// Sueldo mensual, con vigencia.
///
/// No se guarda un solo monto editable sino uno por cada vez que cambia, con
/// el mes desde el que rige. Asi un aumento en marzo no reescribe lo que
/// ganabas en febrero, y el historial de meses viejos sigue siendo cierto.
model Sueldo {
  id            String   @id @default(cuid())
  hogarId       String   @map("hogar_id")
  /// Pesos chilenos enteros. Cero es valido: un mes sin ingresos.
  monto         Int
  /// Primer dia del mes desde el que rige este monto. Uno por mes en cada hogar.
  vigenteDesde  DateTime @map("vigente_desde") @db.Date
  nota          String?  @db.VarChar(200)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  hogar Hogar @relation(fields: [hogarId], references: [id], onDelete: Restrict)

  @@unique([hogarId, vigenteDesde])
  @@map("sueldos")
}

/// Deuda pagada en cuotas fijas.
///
/// Se guarda el mes de la PRIMERA cuota en vez de "cuotas pagadas": las dos
/// cosas son equivalentes, pero el mes no se pone viejo. En noviembre la app
/// sola sabe que vas una cuota mas adelante, sin tener que marcar nada.
model Deuda {
  id            String   @id @default(cuid())
  hogarId       String   @map("hogar_id")
  nombre        String   @db.VarChar(80)
  /// Monto de cada cuota, en pesos.
  montoCuota    Int      @map("monto_cuota")
  cuotasTotales Int      @map("cuotas_totales")
  /// Primer dia del mes en que se paga la primera cuota.
  primeraCuota  DateTime @map("primera_cuota") @db.Date
  /// false si se pago antes de tiempo o se anulo.
  activa        Boolean  @default(true)
  nota          String?  @db.VarChar(200)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  hogar         Hogar         @relation(fields: [hogarId], references: [id], onDelete: Restrict)
  cuotasPagadas CuotaPagada[]

  @@index([activa, primeraCuota])
  @@index([hogarId])
  @@map("deudas")
}

/// Una cuota de una deuda, ya pagada.
///
/// Las cuotas no se guardan por adelantado: se calculan del mes de la primera
/// cuota mas el total. Aqui queda registro solo de la que SI se pago, con el
/// dia exacto y el gasto que genero.
///
/// El par (deuda, mes) es unico: no se puede pagar dos veces la misma cuota.
model CuotaPagada {
  id       String   @id @default(cuid())
  deudaId  String   @map("deuda_id")
  /// Mes de la cuota, guardado como el primer dia de ese mes.
  mes      DateTime @db.Date
  /// Dia exacto en que se pago.
  pagadaEn DateTime @map("pagada_en") @db.Date
  /// Lo que se pago de verdad, que puede diferir de la cuota pactada.
  monto    Int
  gastoId  String?  @unique @map("gasto_id")
  creadoEn DateTime @default(now()) @map("creado_en")

  deuda Deuda  @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  gasto Gasto? @relation(fields: [gastoId], references: [id], onDelete: SetNull)

  @@unique([deudaId, mes])
  @@index([mes])
  @@map("cuotas_pagadas")
}

/// Cuenta por pagar.
///
/// Es un gasto que todavia no ocurre: luz, agua, internet, el gimnasio. Al
/// marcarla pagada se crea el Gasto correspondiente con la fecha real de pago,
/// asi no hay que anotar lo mismo dos veces y los totales del mes quedan bien.
///
/// Las marcadas `mensual` se regeneran solas al abrir el mes siguiente.
model Cuenta {
  id             String    @id @default(cuid())
  hogarId        String    @map("hogar_id")
  nombre         String    @db.VarChar(120)
  /// Monto esperado. Al pagarla se puede corregir al monto real.
  monto          Int
  /// Mes al que corresponde, guardado como el dia 1.
  mes            DateTime  @db.Date
  /// Dia del mes en que vence, 1 a 31. Opcional.
  diaVencimiento Int?      @map("dia_vencimiento")
  categoriaId    String    @map("categoria_id")
  /// null = pendiente. Con fecha = pagada ese dia exacto.
  pagadaEn       DateTime? @map("pagada_en") @db.Date
  /// El gasto que se creo al pagarla.
  gastoId        String?   @unique @map("gasto_id")
  /// true si debe reaparecer sola el mes siguiente.
  mensual        Boolean   @default(false)
  /// Nombre del archivo de la boleta. Solo el nombre, nunca una ruta.
  boletaArchivo  String?   @map("boleta_archivo") @db.VarChar(255)
  nota           String?   @db.VarChar(500)
  creadoEn       DateTime  @default(now()) @map("creado_en")
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en")

  hogar     Hogar     @relation(fields: [hogarId], references: [id], onDelete: Restrict)
  /// La categoria tiene que ser del mismo hogar que la cuenta.
  categoria Categoria @relation(fields: [categoriaId, hogarId], references: [id, hogarId], onDelete: Restrict)
  /// Si se borra el gasto, la cuenta vuelve a quedar pendiente en vez de
  /// desaparecer con el.
  gasto     Gasto?    @relation(fields: [gastoId], references: [id], onDelete: SetNull)

  /// Una cuenta con el mismo nombre no se repite dentro del mismo mes del
  /// mismo hogar. Es lo que hace que regenerar las mensuales sea idempotente.
  @@unique([hogarId, nombre, mes])
  @@index([mes, pagadaEn])
  @@index([hogarId, mes])
  @@map("cuentas")
}

/// Presupuesto de una categoria para un mes.
///
/// Se define mes a mes: cada mes arranca sin presupuestos. No se arrastra
/// solo como el sueldo, porque un presupuesto es una decision del mes, no
/// una condicion que sigue vigente hasta que la cambies.
model Presupuesto {
  id            String   @id @default(cuid())
  hogarId       String   @map("hogar_id")
  categoriaId   String   @map("categoria_id")
  /// Mes del presupuesto, guardado como el primer dia de ese mes.
  mes           DateTime @db.Date
  monto         Int
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  hogar     Hogar     @relation(fields: [hogarId], references: [id], onDelete: Restrict)
  /// La categoria tiene que ser del mismo hogar que el presupuesto.
  categoria Categoria @relation(fields: [categoriaId, hogarId], references: [id, hogarId], onDelete: Cascade)

  @@unique([categoriaId, mes])
  @@index([mes])
  @@index([hogarId, mes])
  @@map("presupuestos")
}

/// Plata que se aparta como ahorro en un mes.
///
/// Puede haber varios en el mismo mes (lo que se guarda al recibir el sueldo,
/// lo que sobra a fin de mes...). Se descuentan de lo que te queda del mes y
/// se suman al total ahorrado. No van a ninguna categoria porque no son un
/// gasto: la plata sigue siendo tuya.
model Ahorro {
  id            String   @id @default(cuid())
  hogarId       String   @map("hogar_id")
  /// Mes al que corresponde, guardado como el dia 1.
  mes           DateTime @db.Date
  /// Pesos chilenos enteros, mayor que cero (constraint en la migracion).
  monto         Int
  /// Para que es: "Fondo de emergencia", "Vacaciones". Opcional.
  nota          String?  @db.VarChar(120)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  hogar Hogar @relation(fields: [hogarId], references: [id], onDelete: Restrict)

  @@index([mes])
  @@index([hogarId, mes])
  @@map("ahorros")
}

/// Ajustes de cada hogar: una fila por hogar, y el hogar es la llave.
///
/// Sin fila, el hogar usa los valores por omision (el mes calendario).
model Ajustes {
  hogarId       String   @id @map("hogar_id")
  /// Dia en que empieza tu mes de gastos: el dia en que te pagan. Con 27,
  /// noviembre va del 27 de octubre al 26 de noviembre. 1 es el mes calendario.
  diaInicioMes  Int      @default(1) @map("dia_inicio_mes")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  hogar Hogar @relation(fields: [hogarId], references: [id], onDelete: Restrict)

  @@map("ajustes")
}
