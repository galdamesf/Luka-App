# Conexion al Postgres de docker-compose.yml
DATABASE_URL="postgresql://gastos:gastos_local@localhost:5433/control_gastos?schema=public"

# Zona horaria usada para interpretar fechas en la app.
TZ="America/Santiago"

# Tu correo: la primera vez que entras quedas como dueno de «Mi hogar» (el de
# los datos de antes de los hogares). A los demas se los invita desde la
# pagina Hogar de la app.
CORREOS_AUTORIZADOS="tu-correo@gmail.com"
