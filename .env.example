# Conexion al Postgres de docker-compose.yml
DATABASE_URL="postgresql://gastos:gastos_local@localhost:5434/control_gastos?schema=public"

# Zona horaria usada para interpretar fechas en la app.
TZ="America/Santiago"

# Tu correo: la primera vez que entras quedas como dueno de «Mi hogar» (el de
# los datos de antes de los hogares). Los demas entran con su propio hogar, o
# al tuyo si los invitas desde la pagina Hogar de la app.
CORREOS_AUTORIZADOS="tu-correo@gmail.com"

# El correo desde el que Luka manda el codigo para borrar un hogar. Sin esto,
# no se puede borrar un hogar. Con Gmail:
#   1. Activa la verificacion en 2 pasos de esa cuenta de Google.
#   2. Crea una «contrasena de aplicacion» en
#      https://myaccount.google.com/apppasswords (16 letras).
#   3. Pon aqui el correo y esa contrasena, con o sin espacios.
CORREO_SMTP_USUARIO=""
CORREO_SMTP_CLAVE=""
# Solo si no es Gmail (por omision, smtp.gmail.com y el puerto 465):
# CORREO_SMTP_SERVIDOR=""
# CORREO_SMTP_PUERTO=""

# La verificacion en dos pasos: con esta clave se cifra la de la app de
# autenticacion de cada persona y se firman los codigos de respaldo. Sin ella
# no entra nadie. Creala una vez con:
#   openssl rand -base64 32
# y no la cambies: si cambia, todos tienen que configurar su app de nuevo.
# En Vercel va otra distinta (Settings → Environment Variables).
CLAVE_DOS_PASOS=""
